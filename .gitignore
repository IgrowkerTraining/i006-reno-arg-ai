# --- Seguridad y Secretos (¡CRÍTICO!) ---
# Ignoramos todos los archivos de entorno
.env
.env.*
.env.local
.env.production
.env.test
# PERMITIMOS el ejemplo para que otros sepan qué variables configurar
!.env.example
secrets.json
*.pem
*.key
*.crt
.secret_key

# --- Infraestructura y Bases de Datos (Docker) ---
# Ignoramos la carpeta donde Postgres guarda los datos reales
postgres_data/
*.db
*.sqlite3
*.sqlite
# Si usas Redis o similares
dump.rdb

# --- IDEs y Editores de Código ---
.vscode/
.idea/
*.swp
*.swo
.history/
*.sublime-project
*.sublime-workspace

